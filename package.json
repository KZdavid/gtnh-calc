{
  "name": "gtnh-calc",
  "version": "0.1.2",
  "description": "GregTech: New Horizons calculator",
  "main": "index.js",
  "scripts": {
    "copy-files": "copyfiles -u 0 \"index.html\" \"assets/**/*\" \"data/**/*\" dist/",
    "locale:prepare-source": "node scripts/build-localized.cjs --prepare-only",
    "build:localized": "node scripts/build-localized.cjs",
    "build:localized:strict": "node scripts/build-localized.cjs --strict",
    "start": "node scripts/build-localized.cjs && live-server --mount=/:./dist --port=5500",
    "build": "tsc && npm run copy-files",
    "package:desktop": "node scripts/package-desktop.cjs",
    "package:minimal": "node scripts/package-minimal-release.cjs",
    "package:hosting": "node scripts/package-hosting-release.cjs",
    "package:all": "node scripts/package-all.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:snapshot": "jest --updateSnapshot",
    "pretest": "tsc",
    "clear": "rimraf dist .localized-build release"
  },
  "keywords": [
    "gregtech",
    "minecraft",
    "calculator"
  ],
  "author": "ShadowTheAge",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "javascript-lp-solver": "0.4.24",
    "jest": "^29.7.0",
    "live-server": "^1.2.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.1.2",
    "typescript": "^5.8.2"
  }
}
